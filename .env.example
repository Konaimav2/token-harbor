# TH-TUI - TokenHarbor Account Creator & Manager Configuration
# Copy this file to .env and fill in your credentials.
# chmod 600 .env (never commit the actual .env file)

# --- Cloud Mail ---
# URL to your cloud-mail worker deployment
CM_BASE_URL=https://cloud-mail.apipi.workers.dev
# Admin email for cloud-mail (must be set in worker env as ADMIN)
CM_ADMIN_EMAIL=your-admin@email.com
# Admin password for cloud-mail
CM_ADMIN_PASSWORD=your-admin-password

# --- MailG (local API) ---
# Token for MailG API access
TH_MAILG_TOKEN=your-mailg-token
# URL to MailG API server
MAILG_URL=http://127.0.0.1:8790

# --- VNC for manual captcha solving (defaults in th-tui.py if not set) ---
# VNC_BIND: localhost (127.0.0.1) or 0.0.0.0 for remote access
VNC_BIND=127.0.0.1
# VNC_PORT: websockify port (default 6080)
VNC_PORT=6080
# VNC_PASSWORD: x11vnc authentication password
VNC_PASSWORD=your-vnc-password

# --- Tempmail (optional) ---
# TMPMAIL_PASSWORD=your-tempmail-password
